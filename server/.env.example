# HireSense AI Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hiresense?retryWrites=true&w=majority
# If left blank or connection fails, HireSense automatically launches an in-memory database!
MONGODB_URI=

# JWT Secrets
JWT_SECRET=hiresense_super_secure_jwt_secret_key_2026_recruit_intelligence
JWT_EXPIRES_IN=7d

# Hugging Face or External AI Provider (Optional)
# Configurable embedding API. If left empty, HireSense uses its built-in High-Accuracy Local Semantic Vector Engine
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Client URL for CORS
CLIENT_URL=http://localhost:5173
